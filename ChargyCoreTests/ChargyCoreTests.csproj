<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>cloud.charging.open.chargy.tests</RootNamespace>
    <AssemblyName>cloud.charging.open.chargy.tests</AssemblyName>
    <!-- Test names say what they mean; an XML comment on every one of them would
         be a second place to keep the same sentence true. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Charge transparency test fixtures, shared byte-for-byte with ChargyCore.TS.
         Signature verification depends on their exact bytes, so they are copied,
         never transformed. -->
    <None Include="TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChargyCore\ChargyCore.csproj" />
    <ProjectReference Include="..\ChargyCore.QRCodes\ChargyCore.QRCodes.csproj" />
    <!-- The command line verifier is a sample, but it is also the only place
         where exit codes, argument parsing and the printed report exist, and
         those are an interface somebody's script depends on. -->
    <ProjectReference Include="..\ChargyVerify\ChargyVerify.csproj" />
  </ItemGroup>

</Project>
