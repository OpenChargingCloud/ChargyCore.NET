<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>cloud.charging.open.chargy.tests</RootNamespace>
    <AssemblyName>cloud.charging.open.chargy.tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Charge transparency test fixtures, shared byte-for-byte with ChargyCore.TS.
         Signature verification depends on their exact bytes, so they are copied,
         never transformed. -->
    <None Include="TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChargyCore\ChargyCore.csproj" />
    <ProjectReference Include="..\ChargyCore.QRCodes\ChargyCore.QRCodes.csproj" />
  </ItemGroup>

</Project>
