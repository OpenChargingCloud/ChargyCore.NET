<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>cloud.charging.open.chargy.qrcodes</RootNamespace>
    <AssemblyName>cloud.charging.open.chargy.qrcodes</AssemblyName>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Chargy Core QR Codes</Product>
    <Description>Reads charge transparency data from QR code images (PNG, JPEG, GIF, WEBP, BMP and SVG) for ChargyCore. Kept apart from the core library so that consumers who never see QR codes do not have to carry an image decoding stack.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.1" />

    <!-- The SkiaSharp package itself ships native libraries for Windows and macOS
         only, so on Linux every image decode fails. The "NoDependencies" variant is
         self-contained and does not require libfontconfig1 to be installed, which
         matters for the slim container images this library tends to run in. Reading
         a QR code never needs fonts. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChargyCore\ChargyCore.csproj" />
  </ItemGroup>

</Project>
