<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>cloud.charging.open.chargy</RootNamespace>
    <AssemblyName>cloud.charging.open.chargy</AssemblyName>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Chargy Core</Product>
    <Description>A transparency software library for the validation of secure and transparent e-mobility charging processes, as defined by the German Calibration Law ("Eichrecht").</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The i18n dictionary and the default validation rules are shared verbatim with
         ChargyCore.TS and are embedded so that consumers need no side-car files. -->
    <EmbeddedResource Include="Resources\i18n.json" />
    <EmbeddedResource Include="Resources\validationRules.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Styx\Styx\Styx.csproj" />
    <ProjectReference Include="..\..\Hermod\Hermod\Hermod.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach into parsing internals that are deliberately not part
         of the public surface. -->
    <InternalsVisibleTo Include="cloud.charging.open.chargy.tests" />
  </ItemGroup>

</Project>
